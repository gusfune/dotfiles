{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(yarn install)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(npx tsc:*)",
      "Bash(tree:*)",
      "Bash(yarn build:*)",
      "Bash(yarn build)",
      "Bash(bun install)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(bun *)",
      "mcp__Linear__get_attachment",
      "mcp__Linear__list_comments",
      "mcp__Linear__list_cycles",
      "mcp__Linear__get_document",
      "mcp__Linear__list_documents",
      "mcp__Linear__extract_images",
      "mcp__Linear__get_issue",
      "mcp__Linear__list_issues",
      "mcp__Linear__list_issue_statuses",
      "mcp__Linear__get_issue_status",
      "mcp__Linear__list_issue_labels",
      "mcp__Linear__list_projects",
      "mcp__Linear__get_project",
      "mcp__Linear__list_project_labels",
      "mcp__Linear__list_milestones",
      "mcp__Linear__get_milestone",
      "mcp__Linear__list_teams",
      "mcp__Linear__get_team",
      "mcp__Linear__list_users",
      "mcp__Linear__get_user",
      "mcp__Linear__search_documentation",
      "mcp__Linear__list_project_updates",
      "mcp__Linear__get_project_update"
    ],
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": false
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/scripts/hook-handle-use.sh ] && ~/.claude/hooks/peon-ping/scripts/hook-handle-use.sh || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/scripts/hook-handle-rename.sh ] && ~/.claude/hooks/peon-ping/scripts/hook-handle-rename.sh || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/peon-ping/peon.sh ] && ~/.claude/hooks/peon-ping/peon.sh || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "bullshit-detector@serhii-korniienko": true,
    "caveman@caveman": false,
    "code-simplifier@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "planning-with-files@planning-with-files": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "planning-with-files": {
      "source": {
        "source": "github",
        "repo": "OthmanAdi/planning-with-files"
      }
    },
    "serhii-korniienko": {
      "source": {
        "source": "github",
        "repo": "SerhiiKorniienko/bullshit-detector"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen"
}
