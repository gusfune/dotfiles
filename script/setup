#!/bin/bash
# Symlink everything in the repo root into $HOME (with the usual dotfile prefix).
# Safe to re-run: existing symlinks are refreshed in place; real files are
# replaced (the repo becomes source-of-truth).

set -eo pipefail

# Resolve repo root (handles symlinked invocations).
if [[ -L "$0" ]]; then
  SCRIPTSETUP="$(readlink "$0")"
else
  SCRIPTSETUP="$0"
fi
DOTFILESDIRREL="${SCRIPTSETUP%/*}"
[[ "${DOTFILESDIRREL}" = "${SCRIPTSETUP}" ]] && DOTFILESDIRREL="."
cd "${DOTFILESDIRREL}/.." || exit
DOTFILESDIR=$(pwd -P)

UNAME_S="$(uname -s)"
[[ "${UNAME_S}" = "Darwin" ]] && export MACOS=1
[[ "${UNAME_S}" = "Linux"  ]] && export LINUX=1

# Editor config paths per OS.
if [[ -n "${MACOS}" ]]; then
  VSCODE="${HOME}/Library/Application Support/Code/User"
  ZED="${HOME}/.config/zed"
elif [[ -n "${LINUX}" ]]; then
  VSCODE="${HOME}/.config/Code/User"
  ZED="${HOME}/.config/zed"
fi

link_if_needed() {
  local target="$1" source="$2"
  [[ -d "${target%/*}" ]] || mkdir -p "${target%/*}"
  if [[ "${target}" -ef "${source}" ]]; then
    return
  elif [[ -L "${target}" ]]; then
    # -n is what makes this safe for directories: without it, ln dereferences an
    # existing dir symlink and drops the new link *inside* the target.
    ln -sfn "${source}" "${target}"
  else
    # Preserve any real file the user may have by backing it up once.
    [[ -e "${target}" ]] && mv -v "${target}" "${target}.backup.$(date +%s)"
    ln -svfn "${source}" "${target}"
  fi
}

# Walk repo root; symlink files into $HOME with a leading dot.
for DOTFILE in *; do
  HOMEFILE="${HOME}/.${DOTFILE}"
  [[ -d "${DOTFILE}" ]] && DOTFILE="${DOTFILE}/" && IS_DIR=1 || IS_DIR=
  DIRFILE="${DOTFILESDIR}/${DOTFILE}"

  # Dirs and files we never auto-link at the root level.
  case "${DOTFILE}" in
    bin/|script/|claude/|codex/|ghostty/|kimi-code/|mise/|omarchy/|zsh/|.git/|*.md|*.txt|LICENSE|Archfile|Brewfile|vscode-extensions.txt)
      continue
      ;;
  esac

  # Special routing.
  case "${DOTFILE}" in
    gitconfig.local.macos)
      [[ -z "${MACOS}" ]] && continue
      HOMEFILE="${HOME}/.gitconfig.local"
      ;;
    gitconfig.local.linux)
      [[ -z "${LINUX}" ]] && continue
      HOMEFILE="${HOME}/.gitconfig.local"
      ;;
    vscode-settings.json)
      [[ -z "${VSCODE}" ]] && continue
      HOMEFILE="${VSCODE}/settings.json"
      ;;
    vscode-keybindings.json)
      [[ -z "${VSCODE}" ]] && continue
      HOMEFILE="${VSCODE}/keybindings.json"
      ;;
    zed-settings.json)
      [[ -z "${ZED}" ]] && continue
      HOMEFILE="${ZED}/settings.json"
      ;;
    zed-keymap.json)
      [[ -z "${ZED}" ]] && continue
      HOMEFILE="${ZED}/keymap.json"
      ;;
  esac

  # Strip .sh suffix so zshrc.sh -> ~/.zshrc.
  if [[ "${DOTFILE}" = *.sh ]]; then
    HOMEFILE="${HOME}/.${DOTFILE%.sh}"
  fi

  if [[ -z "${IS_DIR}" ]]; then
    link_if_needed "${HOMEFILE}" "${DIRFILE}"
  fi
done

# Point ~/.dotfiles at the repo so scripts can resolve assets (e.g. zsh/).
HOMEDOTFILES="${HOME}/.dotfiles"
if ! [[ "${HOMEDOTFILES}" -ef "${DOTFILESDIR}" ]]; then
  rm -f "${HOMEDOTFILES}"
  ln -sf "${DOTFILESDIR}" "${HOMEDOTFILES}"
fi

# Shared AGENTS doc: Claude and Codex both read the same instructions.
AGENTS_GLOBAL="${DOTFILESDIR}/AGENTS-GLOBAL.md"
link_if_needed "${HOME}/.claude/CLAUDE.md" "${AGENTS_GLOBAL}"
link_if_needed "${HOME}/.codex/AGENTS.md"  "${AGENTS_GLOBAL}"

# Claude settings are intentionally NOT symlinked: Claude rewrites the live
# file with per-machine state (autoMode.environment names real repos + paths)
# that must not land in this public repo. Copy manually, both ways.
#   cp claude/settings.json ~/.claude/settings.json   # repo -> home

# Kimi Code config (safe: no per-machine secrets — oauth entries are keyring
# references; managed providers/models may be rewritten by Kimi on refresh).
link_if_needed "${HOME}/.kimi-code/config.toml"   "${DOTFILESDIR}/kimi-code/config.toml"
link_if_needed "${HOME}/.kimi-code/tui.toml"      "${DOTFILESDIR}/kimi-code/tui.toml"
link_if_needed "${HOME}/.kimi-code/statusline.sh" "${DOTFILESDIR}/kimi-code/statusline.sh"

# Ghostty, macOS only. Only the XDG path is linked: Ghostty 1.3.1 also reads
# ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty, and two
# live configs is one config too many.
#
# Not linked on Linux on purpose. Omarchy owns ~/.config/ghostty/config: it
# pulls colours from the active theme via an include of
# ~/.local/state/omarchy/current/theme/ghostty.conf and carries the CSI-u
# keybinds TUIs rely on for Shift+Enter. Linking over it would break both.
# The Linux palette lives in omarchy/themes/ instead.
if [[ -n "${MACOS}" ]]; then
  link_if_needed "${HOME}/.config/ghostty/config" "${DOTFILESDIR}/ghostty/config.macos"
fi

# Claude status line. Shared by the host settings.json and the sbx kit, which
# symlinks to this same file — one implementation, and the only one whose
# epoch formatting works on GNU date as well as BSD.
link_if_needed "${HOME}/.claude/statusline.sh" "${DOTFILESDIR}/claude/statusline.sh"

# Omarchy desktop config (Linux only).
#
# These are exactly the five files ~/.config/hypr/hyprland.lua requires, which
# Omarchy's own comment calls the user-override surface: "loaded after Omarchy's
# defaults so package updates can improve the defaults without rewriting your
# ~/.config/hypr files."
#
# hyprland.lua itself is deliberately NOT linked. It is the entrypoint, it holds
# no personal config, and three update migrations rewrite it with `mv` — which
# replaces a symlink with a real file and silently orphans the repo copy.
#
# monitors.lua IS linked. No migration touches it, and the QEMU/virgl block the
# installer seeded there is gated on the kernel cmdline, so it self-disables on
# any machine that is not this VM.
if [[ -n "${LINUX}" ]] && [[ -d "${DOTFILESDIR}/omarchy" ]]; then
  for HYPRFILE in bindings looknfeel input autostart monitors; do
    link_if_needed "${HOME}/.config/hypr/${HYPRFILE}.lua" \
                   "${DOTFILESDIR}/omarchy/hypr/${HYPRFILE}.lua"
  done

  # The Omarchy shell config is intentionally NOT symlinked, for the same class
  # of reason as claude/settings.json: the shell persists it with atomic writes
  # (temp file + rename) on every bar/widget/idle change made through the UI,
  # and five migrations rewrite it the same way. Either destroys the link, and
  # the next ./script/setup then quietly reverts the change. Copy by hand:
  #   cp omarchy/shell.json ~/.config/omarchy/shell.json && omarchy restart shell
  #   cp ~/.config/omarchy/shell.json omarchy/shell.json

  # Custom themes sit alongside Omarchy's stock ones and the git-cloned user
  # themes. A symlinked theme dir is treated as user-written and unrestricted,
  # so it may ship the terminal colour files this one needs.
  #   omarchy theme set dracula-pro-van-helsing
  for THEMEDIR in "${DOTFILESDIR}"/omarchy/themes/*/; do
    [[ -d "${THEMEDIR}" ]] || continue
    THEMENAME="$(basename "${THEMEDIR}")"
    link_if_needed "${HOME}/.config/omarchy/themes/${THEMENAME}" "${THEMEDIR%/}"
  done
fi

# Codex config is intentionally NOT symlinked: the repo copy is a template
# (missing per-machine notify path + [projects.*] trust blocks). Copy manually
# on a new machine:
#   cp "${DOTFILESDIR}/codex/config.toml" ~/.codex/config.toml
# then add your notify + project trusts.

# mise tools are intentionally NOT symlinked either, though the reason is churn
# rather than safety: mise does write through a symlink and does keep the
# comment header. But the 13 Omarchy wrappers in ~/.local/bin run `mise use -g`
# on every launch, so a link would put every ad-hoc tool install in the repo's
# working tree. script/omarchy-bootstrap seeds it when there is nothing there.
#   cp "${DOTFILESDIR}/mise/global.toml" ~/.config/mise/config.toml
#   cp ~/.config/mise/config.toml "${DOTFILESDIR}/mise/global.toml"

echo
echo "Done. New shell will pick up the new .zprofile / .zshrc."
