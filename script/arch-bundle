#!/bin/bash
# `brew bundle` for pacman and the AUR, driven by ./Archfile.
#
#   arch-bundle install   # install everything listed (--needed: no reinstalls)
#   arch-bundle dump      # rewrite Archfile from what is explicitly installed
#   arch-bundle check     # drift, both directions
#
# Archfile format: one package per line, `#` comments, sections fenced by
# `# ----- repo -----` and `# ----- aur -----`.

set -eo pipefail

DOTFILESDIR="$(cd "${0%/*}/.." && pwd -P)"
ARCHFILE="${ARCHFILE:-${DOTFILESDIR}/Archfile}"

# `dump` writes the file, so it is the one subcommand that must work without it.
if [[ "${1:-check}" != "dump" && ! -r "${ARCHFILE}" ]]; then
  echo "No Archfile at ${ARCHFILE} — run 'arch-bundle dump' to create one." >&2
  exit 1
fi

# Strip fences, comments and blank lines out of one section.
section() {
  awk -v want="$1" '
    /^# ----- / { sec = $3; next }
    sec != want { next }
    { sub(/[ \t]*#.*/, ""); gsub(/^[ \t]+|[ \t]+$/, "") }
    NF { print }
  ' "${ARCHFILE}" | LC_ALL=C sort -u
}

case "${1:-check}" in
  install)
    # pacman needs root. Say so readably instead of letting the caller see
    # sudo's "a terminal is required" followed by xargs exiting 123.
    if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
      echo "arch-bundle install needs sudo and there is no terminal here to" >&2
      echo "read the password from. Run it directly in a terminal." >&2
      exit 1
    fi

    # Install only what is MISSING. --needed is not enough on its own: it skips
    # a package at the same version but still *upgrades* one that is out of
    # date, and upgrading a single package without a full -Syu is a partial
    # upgrade. That is how asking for a stock `systemd` produces
    #   installing systemd (261.3-1) breaks dependency 'systemd=261.2'
    #   required by systemd-sysvcompat
    # This file lists the whole system so `check` can detect drift, but Omarchy
    # owns the base system — `omarchy update` upgrades it, not this script.
    installed=$(mktemp)
    trap 'rm -f "${installed}"' EXIT
    pacman -Qq | LC_ALL=C sort -u > "${installed}"

    missing_repo=$(section repo | LC_ALL=C comm -23 - "${installed}")
    missing_aur=$(section aur  | LC_ALL=C comm -23 - "${installed}")

    if [[ -z "${missing_repo}" && -z "${missing_aur}" ]]; then
      echo "Nothing missing — every Archfile package is already installed."
      exit 0
    fi

    # Even installing a genuinely new package pulls its dependencies at current
    # repo versions, which on a stale system is still a partial upgrade.
    # checkupdates (pacman-contrib) asks the sync DB without touching anything.
    if command -v checkupdates >/dev/null && [[ -n "$(checkupdates 2>/dev/null)" ]]; then
      echo "note: this system has pending updates. If pacman complains about" >&2
      echo "dependencies, run 'omarchy update' first — Omarchy owns the base" >&2
      echo "system and a single-package upgrade here would be a partial one." >&2
    fi

    if [[ -n "${missing_repo}" ]]; then
      echo "Installing: $(echo ${missing_repo} | tr '\n' ' ')"
      # xargs rather than a pipe: `pacman -S -` reads its target list from stdin
      # and then has no stdin left to read the confirmation prompt from.
      echo "${missing_repo}" | xargs -r sudo pacman -S --needed
    fi

    if [[ -n "${missing_aur}" ]]; then
      if command -v yay >/dev/null; then
        echo "${missing_aur}" | xargs -r yay -S --needed
      else
        echo "yay not found — skipping the AUR section." >&2
      fi
    fi
    ;;

  dump)
    # -Qqen = explicit, from a repo, names only. -Qqem = explicit, foreign (AUR).
    # Plain -Qq would dump every dependency too.
    {
      echo "# Archfile — pacman + AUR manifest. See script/arch-bundle."
      echo "# Regenerated by \`arch-bundle dump\`, which wipes the inline"
      echo "# comments — re-add them by hand for any new entry."
      echo
      echo "# ----- repo -----"
      pacman -Qqen
      echo
      echo "# ----- aur -----"
      pacman -Qqem
    } > "${ARCHFILE}"
    echo "Wrote ${ARCHFILE}"
    ;;

  check)
    # Normalise BOTH sides to bare names before comparing. The repo side has
    # comments and fences and the live side does not, so a plain diff is pure
    # false hits — the same trap the Brewfile drift check documents.
    repo=$(mktemp); live=$(mktemp)
    trap 'rm -f "${repo}" "${live}"' EXIT
    { section repo; section aur; }  | LC_ALL=C sort -u > "${repo}"
    { pacman -Qqen; pacman -Qqem; } | LC_ALL=C sort -u > "${live}"
    # LC_ALL=C on comm too: it needs both inputs in the collation sort produced.
    echo "--- in Archfile, not installed ---"
    LC_ALL=C comm -23 "${repo}" "${live}"
    echo "--- installed, not in Archfile ---"
    LC_ALL=C comm -13 "${repo}" "${live}"
    ;;

  *)
    echo "usage: arch-bundle [install|dump|check]" >&2
    exit 2
    ;;
esac
