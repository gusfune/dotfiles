#!/bin/bash
# Make GitHub work in sbx Docker sandboxes, from either side of the boundary.
#
#   On the host:    seeds the global `github` sbx secret so every future sandbox
#                   inherits GitHub access. Pass a sandbox name to also patch a
#                   running one (the global secret only applies on recreate).
#   In a sandbox:   verifies gh actually works and repairs what it can.
#
# Safe to re-run in both modes.

set -eo pipefail

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[93m%s\033[0m\n' "$*" >&2; }
die()  { printf '\033[91m%s\033[0m\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- sandbox mode

bootstrap_sandbox() {
  say "sbx sandbox: ${SANDBOX_NAME:-unknown}"

  if ! command -v gh >/dev/null 2>&1; then
    say "Installing gh..."
    sudo apt-get update -qq && sudo apt-get install -y -qq gh
  fi

  # gh credentials are injected by the sbx proxy at the network layer, so
  # GH_TOKEN is a `gho_sbxproxymanaged...` sentinel rather than a real token.
  # Only an actual API call proves it works; `gh auth status` reads the sentinel.
  local login
  if login=$(gh api user --jq .login 2>/dev/null) && [[ -n "${login}" ]]; then
    say "GitHub OK — authenticated as ${login}"
  else
    warn "gh cannot reach the GitHub API."
    warn "The sandbox has no github secret. Run this on the HOST:"
    warn "  sbx secret set github --sandbox \"${SANDBOX_NAME:-<sandbox-name>}\" -t \"\$(gh auth token)\""
    warn "Then re-run this script. To cover all future sandboxes, run"
    warn "\`script/sbx-bootstrap\` on the host with no arguments."
    return 1
  fi

  # gh defaults for non-interactive agent shells: never page, never prompt.
  # NEVER add shell completions here — this file is sourced before *every*
  # bash command, and completion scripts (which expect COMP_WORDS et al) break
  # the shell outright: commands start returning no output at all.
  local envfile="${CLAUDE_ENV_FILE:-/etc/sandbox-persistent.sh}"
  if [[ -w "${envfile}" ]] || sudo -n true 2>/dev/null; then
    if ! grep -q 'SBX_GH_DEFAULTS_DONE' "${envfile}" 2>/dev/null; then
      sudo tee -a "${envfile}" >/dev/null <<'EOF'

# Non-interactive gh defaults. Guarded by a marker var (not a grep on the
# values) so re-sourcing this file before every command stays idempotent.
if [ -z "${SBX_GH_DEFAULTS_DONE:-}" ]; then
  export GH_PAGER=cat
  export GH_PROMPT_DISABLED=1
  export GH_NO_UPDATE_NOTIFIER=1
  export SBX_GH_DEFAULTS_DONE=1
fi
EOF
      say "Added gh defaults to ${envfile}"
    else
      say "gh defaults already in ${envfile}"
    fi
  else
    warn "Cannot write ${envfile}; skipping gh defaults."
  fi

  say "Done. git push and gh pr create both work from inside this sandbox."
}

# ------------------------------------------------------------------- host mode

bootstrap_host() {
  command -v gh  >/dev/null 2>&1 || die "gh not found. brew bundle --file=Brewfile (or ./script/arch-bundle install)"
  command -v sbx >/dev/null 2>&1 || die "sbx not found — is the Docker sandbox CLI installed?"

  local token
  token=$(gh auth token 2>/dev/null) || true
  [[ -n "${token}" ]] || die "No gh token on this host. Run: gh auth login"

  # Global: inherited by every sandbox created from here on.
  sbx secret set github -t "${token}"
  say "Set global github secret — all future sandboxes inherit GitHub access."

  # Existing sandboxes don't pick up the global secret until they're recreated,
  # so patch any named one directly.
  if [[ -n "$1" ]]; then
    sbx secret set github --sandbox "$1" -t "${token}"
    say "Set github secret on sandbox '$1' (effective immediately)."
  else
    say "Already-running sandboxes need a recreate, or re-run as:"
    say "  script/sbx-bootstrap <sandbox-name>"
  fi
}

if [[ -n "${IS_SANDBOX}" ]]; then
  bootstrap_sandbox
else
  bootstrap_host "$1"
fi
